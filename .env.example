# =============================================================================
# vibe-kb: переменные окружения (deployment.md §2)
# Скопировать в .env и заполнить секреты. Сам .env в git не попадает.
# =============================================================================

# --- БД ---
KB_DB_URL=postgresql+psycopg://kb:kb@postgres:5432/kb

# --- Кэш/очередь (Valkey, не Redis — концепция §13.1) ---
KB_VALKEY_URL=redis://valkey:6379/0

# --- Хранилище (Silo, S3-совместимый) ---
KB_S3_ENDPOINT=http://silo:9000
KB_S3_ACCESS_KEY=kbadmin
KB_S3_SECRET_KEY=kbadmin123

# --- Аутентификация (АУТ-5, auth-setup.md) ---
# На домашнем стенде issuer переопределяется: http://localhost:8080/auth/realms/corp-kb
KB_KEYCLOAK_ISSUER=https://merch-vibe.ru/auth/realms/corp-kb
KB_KEYCLOAK_AUDIENCES=kb-web,kb-rag,kb-mcp
KB_JWKS_CACHE_TTL=300

# --- Модели (OpenAI-compatible, Этап 1: эмбеддинги bge-m3 dense 1024) ---
KB_EMBEDDINGS_BASE_URL=http://tei:8090/v1
KB_EMBEDDINGS_API_KEY=changeme
KB_EMBEDDINGS_MODEL=bge-m3
KB_EMBEDDINGS_DIMS=1024

# --- Идемпотентность (НФТ-9) ---
KB_IDEMPOTENCY_TTL_HOURS=24

# --- Загрузка (НФТ-5; дефолт, живое значение — в settings БД) ---
KB_UPLOAD_MAX_SIZE_MB=50

# --- Приложение ---
KB_DEBUG=false
